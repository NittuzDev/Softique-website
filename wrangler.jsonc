{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softique-website",
  "compatibility_date": "2026-05-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Create in the Cloudflare dashboard: Storage & Databases -> KV -> Create a
  // namespace. Then paste its Namespace ID below (not a secret, just an id).
  "kv_namespaces": [
    {
      "binding": "BOOKING_KV",
      "id": "563a35ee8110484d8b7627499f4fffed"
    }
  ]
}
