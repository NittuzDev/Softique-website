{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softique-website",
  "compatibility_date": "2026-05-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Create with: npx wrangler kv namespace create BOOKING_KV
  // then replace the id below with the one printed by that command.
  "kv_namespaces": [
    {
      "binding": "BOOKING_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
