# Copy this file to ".dev.vars" (already gitignored) to run `wrangler dev` locally.
# In production, set these as encrypted secrets with `wrangler secret put <NAME>` — see SETUP.md.

# Service account email, e.g. softique-booking@your-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# The FULL private key from the service account JSON key file, "-----BEGIN PRIVATE KEY-----...".
# You may paste it with real newlines or with literal "\n" — both are handled.
GOOGLE_PRIVATE_KEY=

# The calendar to read (read-only, never written to), usually your Google
# account email address, or a calendar ID copied from Google Calendar >
# Settings > <calendar> > "Calendar ID".
GOOGLE_CALENDAR_ID=

# Telegram bot (recommended for production — ntfy.sh free tier 429s from Workers).
# Create a bot with @BotFather, then set the token and your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: ntfy topic URL, e.g. https://ntfy.sh/softique-xxxxxxxx
# Works locally; on Cloudflare, ntfy.sh free tier is usually already rate-limited.
NTFY_URL=

# Optional: only needed if your ntfy topic requires auth.
NTFY_TOKEN=
